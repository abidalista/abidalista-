# Instagram Credentials
# Your Instagram username (without @)
INSTAGRAM_USERNAME=your_username

# Your Instagram password
INSTAGRAM_PASSWORD=your_password

# Target Configuration
# The username of the person you want to send DMs to (without @)
TARGET_USERNAME=recipient_username

# The message you want to send daily
DM_MESSAGE=Good morning! Hope you have a wonderful day!

# Schedule Configuration
# Time to send the message in 24-hour format (HH:MM)
# Default is 09:00 (9:00 AM)
SCHEDULE_TIME=09:00
